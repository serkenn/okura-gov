      "content_type": "text/html",
      "bytes": 4567,
      "sha256": "acefc1183804bb5a00617a1ddcca0524c9682f93cdfb8cee32d5c408a0d03bc1",
      "last_modified": "Wed, 03 Dec 2025 08:31:01 GMT",
      "etag": "\"11d7-6450808492c20\"",
      "saved": ".work\\downloads\\20261109-145824_IMPL_misc_followup\\shitsugi_shotoku_05_64.html",
      "charset": "shift_jis",
      "title": "死亡した配偶者の父母に係る扶養控除｜国税庁",
      "text_chars": 962,
      "text": ".work\\text\\20261109-145824_IMPL_misc_followup\\shitsugi_shotoku_05_64.txt",
      "n_links": 16,
      "matches": {
        "birth_range": [],
        "kinship": [
          {
            "line_no": 11,
            "text": "配偶者の死亡により婚姻関係は解消されますが、その配偶者の父母との姻族関係が直ちに否定されるわけではなく、生存している配偶者が婚姻関係を終了させる意思表示をしない限り死亡した配偶者の直系尊属も「配偶者の直系尊属」に含まれます。"
          },
          {
            "line_no": 13,
            "text": "租税特別措置法第41条の16第1項、民法第728条第2項"
          }
        ],
        "kou_otsu": [],
        "age_rule": []
      },
      "pdf_links": []
    },
    {
      "id": "shitsugi_shotoku_05_67",
      "url": "https://www.nta.go.jp/law/shitsugi/shotoku/05/67.htm",
      "status": 200,
      "final_url": "https://www.nta.go.jp/law/shitsugi/shotoku/05/67.htm",
      "content_type": "text/html",
      "bytes": 5104,
      "sha256": "aaa28b7e20889acfc62053327d1cec453b39340737560536ab67190916109cfa",
      "last_modified": "Wed, 03 Dec 2025 08:31:01 GMT",
      "etag": "\"13f0-6450808474f90\"",
      "saved": ".work\\downloads\\20261109-145824_IMPL_misc_followup\\shitsugi_shotoku_05_67.html",
      "charset": "shift_jis",
      "title": "配偶者の子に係る扶養控除｜国税庁",
      "text_chars": 1261,
      "text": ".work\\text\\20261109-145824_IMPL_misc_followup\\shitsugi_shotoku_05_67.txt",
      "n_links": 16,
      "matches": {
        "birth_range": [],
        "kinship": [
          {
            "line_no": 12,
            "text": "養子縁組をしていない場合であっても、配偶者の子は1親等の姻族に該当し、生計を一にするなど一定の要件を満たす場合には、扶養控除の対象となる控除対象扶養親族に該当します。"
          },
          {
            "line_no": 14,
            "text": "ここでいう「親族」とは、民法の規定に従い、6親等内の血族及び3親等内の姻族をいい（民法第725条）、「姻族」とは、配偶者の血族及び自己の血族の配偶者をいいますので、配偶者の子は、1親等の姻族に該当することとなります。"
          },
          {
            "line_no": 15,
            "text": "なお、養子縁組をした場合には、血族間におけるのと同一の親族関係が生じますので（民法第727条）、1親等の血族に該当することとなります。"
          },
          {
            "line_no": 17,
            "text": "所得税法第2条第1項第34号、第34号の2、第84条、民法第725条、第727条"
          }
        ],
        "kou_otsu": [],
        "age_rule": []
      },
      "pdf_links": []
    },
