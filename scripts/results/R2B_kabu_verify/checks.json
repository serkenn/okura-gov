 "checks": [
  {
   "id": "C01",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:8_4",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "同項第三十号中「山林所得金額」とあるのは、「山林所得金額並びに租税特別措置法第八条の四第一項（上場株式等に係る配当所得等の課税の特例）に規定する上場株式等に係る配当所得等の金額",
   "ok": true
  },
  {
   "id": "C01b",
   "kind": "E1",
   "law": "sochi",
   "asof": "2026-12-31",
   "key": "本則:8_4",
   "law_revision_id": "332AC0000000026_20261204_508AC0000000012",
   "needle": "同項第三十号中「山林所得金額」とあるのは、「山林所得金額並びに租税特別措置法第八条の四第一項（上場株式等に係る配当所得等の課税の特例）に規定する上場株式等に係る配当所得等の金額",
   "ok": true
  },
  {
   "id": "C02",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:8_4",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "その年中に支払を受けるべき特定上場株式等の配当等に係る配当所得につき前項の規定の適用を受けようとする旨の記載のある確定申告書を提出した場合に限り適用する",
   "ok": true
  },
  {
   "id": "C03",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:8_4",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "その者がその同一の年中に支払を受けるべき他の特定上場株式等の配当等に係る配当所得については、同項の規定は、適用しない",
   "ok": true
  },
  {
   "id": "C04",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:8_4",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "の百分の十五に相当する金額に相当する所得税を課する。この場合において、当該上場株式等の配当等に係る配当所得については、同法第九十二条第一項の規定は、適用しない",
   "ok": true
  },
  {
   "id": "C05",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:8_4",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "同条第一項中「各種所得の金額」とあるのは、「各種所得の金額（上場株式等に係る配当所得等の金額を除く。）」とする",
   "ok": true
  },
  {
   "id": "C06",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:8_4",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "これらの規定中「総所得金額」とあるのは、「総所得金額、上場株式等に係る配当所得等の金額」とする",
   "ok": true
  },
  {
   "id": "C07",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:8_5",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "の計算上当該利子等に係る利子所得の金額又は配当等に係る配当所得の金額を除外し",
   "ok": true
  },
  {
   "id": "C08",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:8_5",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "その一回に支払を受けるべき利子等の額又は配当等の額ごとに行うことができる",
   "ok": true
  },
  {
   "id": "C09",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:8_5",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "十万円に配当計算期間",
   "ok": true
  },
  {
   "id": "C10",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:37_11",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "上場株式等に係る譲渡所得等の金額の計算上生じた損失の金額があるときは、同法その他所得税に関する法令の規定の適用については、当該損失の金額は生じなかつたものとみなす",
   "ok": true
  },
  {
   "id": "C11",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:37_11",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "前条第六項の規定は、第一項の規定の適用がある場合について準用する",
   "ok": true
  },
  {
   "id": "C12",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:37_10",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "同項第三十号中「山林所得金額」とあるのは、「山林所得金額並びに租税特別措置法第三十七条の十第一項",
   "ok": true
  },
  {
   "id": "C13",
   "kind": "E1",
   "law": "sochi",
   "asof": "2025-12-31",
   "key": "本則:37_11_5",
   "law_revision_id": "332AC0000000026_20251231_507AC1000000081",
   "needle": "当該各号に掲げる金額（当該各号に掲げる金額が同一の源泉徴収選択口座に係るものである場合には、当該源泉徴収選択口座については、第一号に掲げる金額及び第二号に掲げる金額）を除外したところにより",
   "ok": true
  },
  {
   "id": "C14",
   "kind": "E1",
   "law": "sochi-rei",
   "asof": "2025-12-31",
   "key": "本則:25_10_12",
   "law_revision_id": "332CO0000000043_20251231_507CO0000000401",
   "needle": "（同法第三十七条の十一の五第一項（確定申告を要しない上場株式等の譲渡による所得）の規定の適用を受ける場合には、同項各号に掲げる金額を除外した金額）",
   "ok": true
  },
  {
